<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0-windows</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>disable</Nullable>
		<Version>3.5.1</Version>
		<FileVersion>3.5.1</FileVersion>
		<AssemblyVersion>3.5.1</AssemblyVersion>
		<Platforms>x64</Platforms>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="Services\VirtualPrinter.HostedService.HttpSystem.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Services\VirtualPrinter.HostedService.HttpSystem.json">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Diamond.Core.Extensions.Hosting" Version="10.1.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.6" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Labelary.Abstractions\Labelary.Abstractions.csproj" />
		<ProjectReference Include="..\VirtualPrinter.ApplicationSettings\VirtualPrinter.ApplicationSettings.csproj" />
		<ProjectReference Include="..\VirtualPrinter.GrfStorageService\VirtualPrinter.GrfStorageService.csproj" />
		<ProjectReference Include="..\VirtualPrinter.PublishSubscribe\VirtualPrinter.PublishSubscribe.csproj" />
		<ProjectReference Include="..\VirtualPrinter.ZplFormatService\VirtualPrinter.ZplFormatService.csproj" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\.editorconfig" Link=".editorconfig" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Resources\IndexPage.html" />
		<EmbeddedResource Include="Resources\ZplEditorPage.html" />
	</ItemGroup>

</Project>
